# Ignore the local vendor directory, Composer files are installed in the image
/vendor

# Ignore environment files
# .env
# .env.*

# Ignore IDE/editor files
/.idea
/.vscode
*.swp
*.swo
.DS_Store

# Ignore git metadata
.git
.gitignore

# Ignore logs and runtime files generated outside the image
/storage/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/*

# Ignore node modules if they exist in this repo
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Docker ignore itself
.dockerignore
